# API
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database. Local development can run without this (JSON file store).
# Production must use PostgreSQL, e.g. Supabase / Neon / Render PostgreSQL.
DATABASE_URL=
DATABASE_SSL=false

# Mercado Pago - use TEST credentials first.
# Public key is safe to expose through /api/config.
MP_PUBLIC_KEY=TU_PUBLIC_KEY
# Private access token: NEVER expose this in frontend code.
MP_ACCESS_TOKEN=TU_ACCESS_TOKEN
# Secret generated in Mercado Pago > Integrations > Webhooks.
MP_WEBHOOK_SECRET=
MP_ENVIRONMENT=test
# The buyer chooses the amount during checkout; there is no fixed amount.

# Production safety switch. Only enable after having a legitimate, verified merchant
# account and real products/services to fulfill. Never enable for a fictitious store.
ENABLE_LIVE_PAYMENTS=false
STORE_LEGAL_SELLER_CONFIRMED=false

# Frontend API URL. Leave blank for local Vite proxy.
VITE_API_URL=
